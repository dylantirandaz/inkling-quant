+void ggml_backend_sched_set_owner(
+        ggml_backend_sched_t sched,
+        enum ggml_backend_sched_owner owner) {
+    GGML_ASSERT(sched != nullptr);
+    GGML_ASSERT(
+            owner == GGML_BACKEND_SCHED_OWNER_UNKNOWN ||
+            owner == GGML_BACKEND_SCHED_OWNER_TEXT ||
+            owner == GGML_BACKEND_SCHED_OWNER_VISION ||
+            owner == GGML_BACKEND_SCHED_OWNER_AUDIO);
+    sched->iql_owner = owner;
+}
+
+static const char * ggml_backend_sched_iql_owner_name(enum ggml_backend_sched_owner owner) {
+    switch (owner) {
+        case GGML_BACKEND_SCHED_OWNER_TEXT:
+            return "text";
+        case GGML_BACKEND_SCHED_OWNER_VISION:
+            return "vision";
+        case GGML_BACKEND_SCHED_OWNER_AUDIO:
+            return "audio";
+        case GGML_BACKEND_SCHED_OWNER_UNKNOWN:
+            return "unknown";
+    }
+
+    return "unknown";
+}
+
+static void ggml_backend_sched_iql_audit(ggml_backend_sched_t sched, struct ggml_cgraph * graph) {
+    size_t backend_compute_counts[GGML_SCHED_MAX_BACKENDS] = {};
+    size_t compute_count = 0;
+    size_t gpu_count = 0;
+    size_t cpu_count = 0;
+    size_t accelerator_count = 0;
+    size_t other_count = 0;
+    size_t unassigned_count = 0;
+    size_t cpu_diagnostics = 0;
+    const char * graph_owner = ggml_backend_sched_iql_owner_name(sched->iql_owner);
+
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        struct ggml_tensor * node = graph->nodes[i];
+        if (node->op == GGML_OP_NONE || ggml_is_view_op(node->op)) {
+            continue;
+        }
+
+        ++compute_count;
+        const int backend_id = tensor_backend_id(node);
+        if (backend_id < 0 || backend_id >= sched->n_backends) {
+            ++unassigned_count;
+            continue;
+        }
+
+        ++backend_compute_counts[backend_id];
+        ggml_backend_t backend = sched->backends[backend_id];
+
+        ggml_backend_dev_t device = ggml_backend_get_device(backend);
+        if (device == NULL) {
+            ++unassigned_count;
+            continue;
+        }
+
+        switch (ggml_backend_dev_type(device)) {
+            case GGML_BACKEND_DEVICE_TYPE_GPU:
+            case GGML_BACKEND_DEVICE_TYPE_IGPU:
+                ++gpu_count;
+                break;
+            case GGML_BACKEND_DEVICE_TYPE_CPU:
+                ++cpu_count;
+                if (cpu_diagnostics < 8) {
+                    size_t name_len = 0;
+                    while (name_len < sizeof(node->name) && node->name[name_len] != '\0') {
+                        ++name_len;
+                    }
+                    char name_hex[2 * sizeof(node->name) + 1] = {};
+                    static const char hex_digits[] = "0123456789abcdef";
+                    for (size_t j = 0; j < name_len; ++j) {
+                        const uint8_t byte = static_cast<uint8_t>(node->name[j]);
+                        name_hex[2 * j] = hex_digits[byte >> 4];
+                        name_hex[2 * j + 1] = hex_digits[byte & 0x0f];
+                    }
+                    GGML_LOG_INFO(
+                            "IQL_SMOKE_CPU_NODE_V2 graph_uid=%" PRIu64 " graph_owner=%s backend_index=%d device_type=cpu ordinal=%d op=%s name_len=%zu name_hex=%s\n",
+                            graph->uid,
+                            graph_owner,
+                            backend_id,
+                            i,
+                            ggml_op_name(node->op),
+                            name_len,
+                            name_hex);
+                    ++cpu_diagnostics;
+                }
+                break;
+            case GGML_BACKEND_DEVICE_TYPE_ACCEL:
+                ++accelerator_count;
+                break;
+            case GGML_BACKEND_DEVICE_TYPE_META:
+                ++other_count;
+                break;
+        }
+    }
+
+    for (int backend_id = 0; backend_id < sched->n_backends; ++backend_id) {
+        if (backend_compute_counts[backend_id] == 0) {
+            continue;
+        }
+
+        ggml_backend_t backend = sched->backends[backend_id];
+        ggml_backend_dev_t device = ggml_backend_get_device(backend);
+        const char * device_name = "null";
+        const char * device_type_name = "unassigned";
+        if (device != NULL) {
+            device_name = ggml_backend_dev_name(device);
+            switch (ggml_backend_dev_type(device)) {
+                case GGML_BACKEND_DEVICE_TYPE_CPU:
+                    device_type_name = "cpu";
+                    break;
+                case GGML_BACKEND_DEVICE_TYPE_GPU:
+                    device_type_name = "gpu";
+                    break;
+                case GGML_BACKEND_DEVICE_TYPE_IGPU:
+                    device_type_name = "igpu";
+                    break;
+                case GGML_BACKEND_DEVICE_TYPE_ACCEL:
+                    device_type_name = "accel";
+                    break;
+                case GGML_BACKEND_DEVICE_TYPE_META:
+                    device_type_name = "meta";
+                    break;
+            }
+        }
+
+        GGML_LOG_INFO(
+                "IQL_SMOKE_BACKEND_IDENTITY_V2 graph_uid=%" PRIu64 " graph_owner=%s backend_index=%d backend_name=%s device_name=%s device_type=%s compute=%zu\n",
+                graph->uid,
+                graph_owner,
+                backend_id,
+                ggml_backend_name(backend),
+                device_name,
+                device_type_name,
+                backend_compute_counts[backend_id]);
+    }
+
+    GGML_LOG_INFO(
+            "IQL_SMOKE_BACKEND_GRAPH_V2 graph_uid=%" PRIu64 " graph_owner=%s phase=post_assignment_pre_split scope=non_view_compute compute=%zu gpu=%zu cpu=%zu accel=%zu other=%zu unassigned=%zu\n",
+            graph->uid,
+            graph_owner,
+            compute_count,
+            gpu_count,
+            cpu_count,
+            accelerator_count,
+            other_count,
+            unassigned_count);
+}
